#!/usr/bin/perl
# timeout SECONDS COMMAND [ARG ...]: run COMMAND, killing it (SIGKILL)
# if it runs longer than SECONDS; exit with its status, or 142 (as for
# SIGALRM) if it was killed. A signal to the command itself is not
# enough: Go's runtime does not die of SIGALRM.
use strict;
my $secs = shift;
my $pid = fork() // die "fork: $!";
if ($pid == 0) { exec @ARGV or die "exec $ARGV[0]: $!\n" }
local $SIG{ALRM} = sub { kill 'KILL', $pid; waitpid($pid, 0); exit 142 };
alarm $secs;
waitpid($pid, 0);
alarm 0;
exit($? & 127 ? 128 + ($? & 127) : $? >> 8);
