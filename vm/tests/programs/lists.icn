# Lists: construction, subscripts, element generation and update.
procedure main()
   local L, M, x
   L := [1, "two", [3]]
   write(image(L), " ", *L, " ", type(L))
   write(image(L[3]), " ", L[3][1], " ", L[-1][1], " ", L[2])
   write(image(L[4]) | "L[4] fails")
   write(image(L[0]) | "L[0] fails")
   L[1] := "one"
   L[-1] := 3
   every writes(image(!L), " ")
   write()
   every !L := 0
   every writes(!L, " ")
   write()
   L := list(3, "x")
   every writes(!L, " ")
   write(*L)
   L := []
   put(L, 1, 2)
   put(L, 3)
   push(L, 0)
   push(L, -2, -1)
   every writes(!L, " ")
   write()
   write(get(L), " ", pop(L), " ", pull(L), " ", *L)
   every writes(!L, " ")
   write()
   while x := get(L) do writes(x, " ")
   write(*L)
   write(image(get(L)) | "get fails on empty list")
   L := [1, 2, 3, 4, 5]
   M := L[2:4]
   write(image(M), " ", M[1], " ", M[2])
   M := L[2+:3] ||| [6]
   every writes(!M, " ")
   write()
   write(image([]), " ", image(L ||| L))
   L := [[1, 2], [3, 4]]
   write(L[2, 1], " ", L[1][2])
   L[1, 1] := "x"
   write(L[1][1])
   L := [1, 2, 3]
   every x := !L do x := 0
   every writes(!L, " ")
   write()
   L := [1, , 3]
   write(*L, " ", image(L[2]))
end
