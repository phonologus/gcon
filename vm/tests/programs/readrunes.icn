# reads counts bytes, as in Icon 9.5; readrunes counts characters
# (UTF-8 characters, never splitting a sequence).
procedure main()
   local f, s, t
   f := open("rr.tmp", "w") | stop("cannot open")
   # c a f C3A9 " " E4B896 E7958C 80 ! : 10 characters, 14 bytes
   writes(f, "café 世界\x80!")
   close(f)

   f := open("rr.tmp")
   s := reads(f, 4)
   write(image(s), " ", *s, " ", len(s), " ", where(f))
   t := reads(f)
   write(image(t), " ", *t, " ", where(f))
   write(image(s || t), " ", s || t == "café")
   write(image(reads(f, 100)), " ", where(f))
   write(image(reads(f)) | "eof")

   seek(f, 1)
   write(image(readrunes(f, 4)), " ", where(f))
   write(image(readrunes(f, 3)), " ", where(f))
   write(image(readrunes(f)), " ", where(f))
   write(image(readrunes(f, 5)), " ", where(f))
   write(image(readrunes(f)) | "eof")

   # a byte read and backed over, as the IPL's binary readers do
   seek(f, 5)
   s := reads(f)
   seek(f, where(f) - 1)
   write(image(s), " ", where(f), " ", image(readrunes(f)))

   # reads produces the bytes, as binary readers need
   seek(f, 4)
   s := reads(f, 2)
   write(ord(s[1]), " ", ord(s[2]), " ", len(s), " ", image(s))
   close(f)

   f := open("rr.tmp", "u")
   write(image(readrunes(f, 4)), " ", image(reads(f, 3)), " ", where(f))
   write(image(readrunes(f, 2)), " ", ord(reads(f)), " ", where(f))
   close(f)
   remove("rr.tmp")

   # large reads, across the 64K buffer: sequences straddling its end,
   # a regular file's remaining size, a pipe growing the result
   t := repl("é", 100000) || "z"
   f := open("rr.tmp", "w")
   writes(f, t)
   close(f)
   f := open("rr.tmp")
   s := readrunes(f, 70000)
   write(*s, " ", len(s), " ", where(f))
   s := reads(f, 3)
   write(image(s), " ", where(f))
   s := readrunes(f, 1000000)
   write(*s, " ", len(s), " ", image(s[-3:0]), " ", where(f))
   seek(f, 1)
   s := reads(f, 2 ^ 40)
   write(*s, " ", type(s), " ", same(s, t), " ", image(reads(f)) | "eof")
   close(f)
   f := open("cat rr.tmp rr.tmp rr.tmp", "p")
   s := reads(f, 500000)
   write(*s, " ", same(s, (t || t || t)[1:500001]))
   s := reads(f, 1000000)
   write(*s, " ", same(s, (t || t || t)[500001:0]), " ", image(reads(f)) | "eof")
   close(f)
   f := open("cat rr.tmp", "p")
   s := ""
   while s ||:= reads(f, 65536)
   write(*s, " ", same(s, t))
   close(f)
   remove("rr.tmp")

   # a directory's entries are cut likewise
   system("mkdir rr.d && : >rr.d/éa && : >rr.d/éb")
   f := open("rr.d") | stop("cannot open rr.d")
   read(f) & read(f)
   write(image(readrunes(f, 1)), " ", image(reads(f, 1)), " ", image(reads(f)) | "eof")
   close(f)
   system("rm -r rr.d")

   write(image(reads(, 3)), " ", image(readrunes(&input, 3)), " ", image(read()))
end

procedure same(s1, s2)
   return if s1 == s2 then "same" else "differ"
end
