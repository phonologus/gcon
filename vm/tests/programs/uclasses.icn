# The uclass module (lib/gcon/uclass.icn, generated by build.sh from the
# vendored Unicode database): gcon's own, so the expected output is
# recorded from gcon, not iconx. Counts are Unicode 17.0.0's.
link uclass

procedure main()
   local L, s, n
   L := uclass("L")
   write(type(L), " ", *L, " ", *uclass("Lu"), " ", *uclass("Ll"), " ", *uclass("Nd"),
      " ", *uclass("P"), " ", *uclass("Z"))
   write(*uclass("Latin"), " ", *uclass("Greek"), " ", *uclass("Han"), " ", *uclass("Common"))
   write(image(uclass("Zs")))
   every n := "Nope" | "l" | "Cs" | "" | "Lu" do writes(n, ":", (uclass(n) & "found") | "fails", " ")
   write()
   # a major category is the union of its subcategories
   write(L === uclass("Lu") ++ uclass("Ll") ++ uclass("Lt") ++ uclass("Lm") ++ uclass("Lo") & "union")
   write(uclass("Lu") ** uclass("Ll") === u'' & "disjoint")
   write(uclass("L") === uclass("L") & "same")
   # words of any script
   s := "Ωmega 42 straße, 世界 ok; ٣ dígitos"
   s ? while tab(upto(L)) do writes(image(tab(many(L ++ uclass("Mn")))), " ")
   write()
   every writes(upto(uclass("Nd"), s), " ")
   write()
   n := 0
   every upto(uclass("Greek") ++ uclass("Han"), s) do n +:= 1
   write(n)
end
