# Files: standard streams, reading, writing, pipes.
procedure main()
   local f, s, n, g
   write("out1")
   write(&errout, "err1")
   while s := read() do write(image(s))
   write(image(read()) | "eof")
   write(image(&input), " ", image(&output), " ", image(&errout), " ", type(&input))
   f := open("tmp.out", "w") | stop("cannot open")
   write(image(f), " ", type(f))
   write(f, "line one")
   writes(f, "a", "b", 1, 2.5)
   write(f)
   write(f, "x", &output, "to output")
   close(f)
   f := open("tmp.out")
   every write(image(!f))
   close(f)
   f := open("tmp.out")
   write(image(reads(f, 3)), " ", image(reads(f)), " ", image(reads(f, 100)), " ", image(reads(f, 1)) | "eof")
   close(f)
   write(image(open("nonexistent.file")) | "open fails")
   f := open("tmp.out", "a")
   write(f, "appended")
   close(f)
   f := open("tmp.out")
   n := 0
   while s := read(f) do n +:= 1
   write(n, " lines")
   seek(f, 1)
   write(read(f), " ", where(f))
   seek(f, -9)
   write(image(read(f)))
   close(f)
   write(image(write(&output)), "|", image(write()), "|", image(write("a", "b")), "|", image(writes()))
   g := open("echo piped; echo two", "p")
   while write("pipe: ", read(g))
   write("close pipe: ", close(g))
   g := open("cat", "pw")
   write(g, "into a pipe")
   close(g)
   write("system: ", system("exit 3"))
   write(rename("tmp.out", "tmp2.out") & "renamed", " ", image(open("tmp.out")) | "old name gone")
   write(remove("tmp2.out") & "removed", " ", image(remove("tmp2.out")) | "remove fails")
   write(image(getenv("GCON_NO_SUCH_VARIABLE")) | "no such variable")
   write(&errout, "err2")
   stop("stopped ", 1)
end
