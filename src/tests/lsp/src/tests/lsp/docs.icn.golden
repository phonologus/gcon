":"Draw bitmapped figure"},"sortText":"2DrawImage"},{"label":"DrawLine","kind":3,"detail":"DrawLine(argv[])","documentation":{"kind":"markdown","value":"Draw line"},"sortText":"2DrawLine"},{"label":"DrawPoint","kind":3,"detail":"DrawPoint(argv[])","documentation":{"kind":"markdown","value":"Draw point"},"sortText":"2DrawPoint"},{"label":"DrawPolygon","kind":3,"detail":"DrawPolygon(argv[])","documentation":{"kind":"markdown","value":"Draw polygon"},"sortText":"2DrawPolygon"},{"label":"DrawRectangle","kind":3,"detail":"DrawRectangle(argv[])","documentation":{"kind":"markdown","value":"Draw rectangle"},"sortText":"2DrawRectangle"},{"label":"DrawSegment","kind":3,"detail":"DrawSegment(argv[])","documentation":{"kind":"markdown","value":"Draw line segment"},"sortText":"2DrawSegment"},{"label":"DrawString","kind":3,"detail":"DrawString(argv[])","documentation":{"kind":"markdown","value":"Draw text"},"sortText":"2DrawString"},{"label":"EraseArea","kind":3,"detail":"EraseArea(w,x,y,width,height)","documentation":{"kind":"markdown","value":"Clear an area of the window"},"sortText":"2EraseArea"},{"label":"Event","kind":3,"detail":"Event(w)","documentation":{"kind":"markdown","value":"Return an event from a window"},"sortText":"2Event"},{"label":"Fg","kind":3,"detail":"Fg(w,s)","documentation":{"kind":"markdown","value":"Foreground color"},"sortText":"2Fg"},{"label":"FillArc","kind":3,"detail":"FillArc(argv[])","documentation":{"kind":"markdown","value":"Fill arc"},"sortText":"2FillArc"},{"label":"FillCircle","kind":3,"detail":"FillCircle(argv[])","documentation":{"kind":"markdown","value":"Draw filled circle"},"sortText":"2FillCircle"},{"label":"FillPolygon","kind":3,"detail":"FillPolygon(argv[])","documentation":{"kind":"markdown","value":"Fill polygon"},"sortText":"2FillPolygon"},{"label":"FillRectangle","kind":3,"detail":"FillRectangle(argv[])","documentation":{"kind":"markdown","value":"Draw filled rectangle"},"sortText":"2FillRectangle"},{"label":"Font","kind":3,"detail":"Font(w,s)","documentation":{"kind":"markdown","value":"Get/set font"},"sortText":"2Font"},{"label":"FreeColor","kind":3,"detail":"FreeColor(argv[])","documentation":{"kind":"markdown","value":"Free colors"},"sortText":"2FreeColor"},{"label":"GotoRC","kind":3,"detail":"GotoRC(w,r,c)","documentation":{"kind":"markdown","value":"Move cursor to a particular text row and column"},"sortText":"2GotoRC"},{"label":"GotoXY","kind":3,"detail":"GotoXY(w,x,y)","documentation":{"kind":"markdown","value":"Move cursor to a particular pixel location"},"sortText":"2GotoXY"},{"label":"Lower","kind":3,"detail":"Lower(w)","documentation":{"kind":"markdown","value":"Lower w to the bottom of the window stack"},"sortText":"2Lower"},{"label":"NewColor","kind":3,"detail":"NewColor(w,s)","documentation":{"kind":"markdown","value":"Allocate an entry in the color map"},"sortText":"2NewColor"},{"label":"PaletteChars","kind":3,"detail":"PaletteChars(w,p)","documentation":{"kind":"markdown","value":"Return the characters forming keys to palette p"},"sortText":"2PaletteChars"},{"label":"PaletteColor","kind":3,"detail":"PaletteColor(w,p,s)","documentation":{"kind":"markdown","value":"Return color of key s in palette p"},"sortText":"2PaletteColor"},{"label":"PaletteKey","kind":3,"detail":"PaletteKey(w,p,s)","documentation":{"kind":"markdown","value":"Return key of closest color to s in palette p"},"sortText":"2PaletteKey"},{"label":"Pattern","kind":3,"detail":"Pattern(w,s)","documentation":{"kind":"markdown","value":"Sets the context fill pattern by string name"},"sortText":"2Pattern"},{"label":"Pending","kind":3,"detail":"Pending(w,x[])","documentation":{"kind":"markdown","value":"Produce a list of events pending on window"},"sortText":"2Pending"},{"label":"Pixel","kind":3,"detail":"Pixel(w,x,y,width,height)","documentation":{"kind":"markdown","value":"Produce the contents of some pixels"},"sortText":"2Pixel"},{"label":"QueryPointer","kind":3,"detail":"QueryPointer(w)","documentation":{"kind":"markdown","value":"Produce mouse position"},"sortText":"2QueryPointer"},{"label":"Raise","kind":3,"detail":"Raise(w)","documentation":{"kind":"markdown","value":"Raise w to the top of the window stack"},"sortText":"2Raise"},{"label":"ReadImage","kind":3,"detail":"ReadImage(w,s,x,y,p)","documentation":{"kind":"markdown","value":"Load image file"},"sortText":"2ReadImage"},{"label":"TextWidth","kind":3,"detail":"TextWidth(w,s)","documentation":{"kind":"markdown","value":"Compute text pixel width"},"sortText":"2TextWidth"},{"label":"Uncouple","kind":3,"detail":"Uncouple(w)","documentation":{"kind":"markdown","value":"Uncouple window"},"sortText":"2Uncouple"},{"label":"WAttrib","kind":3,"detail":"WAttrib(argv[])","documentation":{"kind":"markdown","value":"Read/write window attributes"},"sortText":"2WAttrib"},{"label":"WDefault","kind":3,"detail":"WDefault(w,program,option)","documentation":{"kind":"markdown","value":"Get a default value from the environment"},"sortText":"2WDefault"},{"label":"WFlush","kind":3,"detail":"WFlush(w)","documentation":{"kind":"markdown","value":"Flush all output to window w"},"sortText":"2WFlush"},{"label":"WSync","kind":3,"detail":"WSync(w)","documentation":{"kind":"markdown","value":"Synchronize with server"},"sortText":"2WSync"},{"label":"WinButton","kind":3,"detail":"WinButton(w,s,x,y,wd,ht)","documentation":{"kind":"markdown","value":"Install a pushbutton with label s on window w"},"sortText":"2WinButton"},{"label":"WinColorDialog","kind":3,"detail":"WinColorDialog(w,s)","documentation":{"kind":"markdown","value":"Choose a color for a window's context"},"sortText":"2WinColorDialog"},{"label":"WinEditRegion","kind":3,"detail":"WinEditRegion(W,s,s2,x,y,w,h)","documentation":{"kind":"markdown","value":"Install an edit box with label s (Microsoft Windows only)."},"sortText":"2WinEditRegion"},{"label":"WinFontDialog","kind":3,"detail":"WinFontDialog(w,s)","documentation":{"kind":"markdown","value":"Choose a font for a window's context"},"sortText":"2WinFontDialog"},{"label":"WinMenuBar","kind":3,"detail":"WinMenuBar(w,L1,L2,...)","documentation":{"kind":"markdown","value":"Install a set of top-level menus"},"sortText":"2WinMenuBar"},{"label":"WinOpenDialog","kind":3,"detail":"WinOpenDialog(w,s1,s2,i,s3,j)","documentation":{"kind":"markdown","value":"Choose a file to open"},"sortText":"2WinOpenDialog"},{"label":"WinPlayMedia","kind":3,"detail":"WinPlayMedia(w,x[])","documentation":{"kind":"markdown","value":"Play a multimedia resource"},"sortText":"2WinPlayMedia"},{"label":"WinSaveDialog","kind":3,"detail":"WinSaveDialog(w,s1,s2,i,s3,j)","documentation":{"kind":"markdown","value":"Choose a file to save"},"sortText":"2WinSaveDialog"},{"label":"WinScrollBar","kind":3,"detail":"WinScrollBar(w,s,i1,i2,i3,x,y,wd,ht)","documentation":{"kind":"markdown","value":"Install a scrollbar"},"sortText":"2WinScrollBar"},{"label":"WinSelectDialog","kind":3,"detail":"WinSelectDialog(w,s1,buttons)","documentation":{"kind":"markdown","value":"Select from a set of choices"},"sortText":"2WinSelectDialog"},{"label":"WriteImage","kind":3,"detail":"WriteImage(w,filename,x,y,width,height)","documentation":{"kind":"markdown","value":"Write an image to a file"},"sortText":"2WriteImage"},{"label":"abs","kind":3,"detail":"abs(N)","documentation":{"kind":"markdown","value":"Produces the absolute value of N."},"sortText":"2abs"},{"label":"acos","kind":3,"detail":"acos(r)","documentation":{"kind":"markdown","value":"Arc cosine of r, in radians."},"sortText":"2acos"},{"label":"any","kind":3,"detail":"any(c,s,i1,i2)","documentation":{"kind":"markdown","value":"Produces i1+1 if i2 is greater than 1 and s[i] is contained in c and poseq(i2,x) is greater than poseq(i1,x), but fails otherwise."},"sortText":"2any"},{"label":"args","kind":3,"detail":"args(p)","documentation":{"kind":"markdown","value":"Produce number of arguments for procedure p."},"sortText":"2args"},{"label":"asin","kind":3,"detail":"asin(r)","documentation":{"kind":"markdown","value":"Arc sine of r, in radians."},"sortText":"2asin"},{"label":"atan","kind":3,"detail":"atan(r1,r2)","documentation":{"kind":"markdown","value":"R1, r2 in radians; if r2 is present, produces atan2(r1,r2)."},"sortText":"2atan"},{"label":"bal","kind":3,"detail":"bal(c1,c2,c3,s,i1,i2)","documentation":{"kind":"markdown","value":"Generates the sequence of integer positions in s up to a character of c1 in s[i1:i2] that is balanced with respect to characters in c2 and c3, but fails if there is no such position."},"sortText":"2bal"},{"label":"bytes","kind":3,"detail":"bytes(x)","documentation":{"kind":"markdown","value":"Relabel a string as bytes; or the bytes matching a cset"},"sortText":"2bytes"},{"label":"center","kind":3,"detail":"center(s1,i,s2)","documentation":{"kind":"markdown","value":"Pad s1 on left and right with s2 to length i."},"sortText":"2center"},{"label":"char","kind":3,"detail":"char(i)","documentation":{"kind":"markdown","value":"Produce a string consisting of character i."},"sortText":"2char"},{"label":"chdir","kind":3,"detail":"chdir(s)","documentation":{"kind":"markdown","value":"Change working directory to s."},"sortText":"2chdir"},{"label":"close","kind":3,"detail":"close(f)","documentation":{"kind":"markdown","value":"Close file f."},"sortText":"2close"},{"label":"collect","kind":3,"detail":"collect(i1,i2)","documentation":{"kind":"markdown","value":"Call garbage collector to ensure i2 bytes in region i1. no longer works."},"sortText":"2collect"},{"label":"copy","kind":3,"detail":"copy(x)","documentation":{"kind":"markdown","value":"Make a copy of object x."},"sortText":"2copy"},{"label":"cos","kind":3,"detail":"cos(r)","documentation":{"kind":"markdown","value":"Cosine of r, r in radians."},"sortText":"2cos"},{"label":"cset","kind":3,"detail":"cset(x)","documentation":{"kind":"markdown","value":"Convert x to a cset, failing if that is not possible."},"sortText":"2cset"},{"label":"delay","kind":3,"detail":"delay(i)","documentation":{"kind":"markdown","value":"Delay for i milliseconds."},"sortText":"2delay"},{"label":"delete","kind":3,"detail":"delete(x1,x2)","documentation":{"kind":"markdown","value":"Delete element x2 from set or table x1 if it is there (always succeeds and returns x1)."},"sortText":"2delete"},{"label":"detab","kind":3,"detail":"detab(s,i,...)","documentation":{"kind":"markdown","value":"Replace tabs with spaces, with stops at columns indicated."},"sortText":"2detab"},{"label":"display","kind":3,"detail":"display(i,f)","documentation":{"kind":"markdown","value":"Display local variables of i most recent procedure activations, plus global variables. Output to file f (default \u0026errout)."},"sortText":"2display"},{"label":"dtor","kind":3,"detail":"dtor(r)","documentation":{"kind":"markdown","value":"Convert r from degrees to radians."},"sortText":"2dtor"},{"label":"entab","kind":3,"detail":"entab(s,i,...)","documentation":{"kind":"markdown","value":"Replace spaces with tabs, with stops at columns indicated."},"sortText":"2entab"},{"label":"errorclear","kind":3,"detail":"errorclear()","documentation":{"kind":"markdown","value":"Clear error condition."},"sortText":"2errorclear"},{"label":"exit","kind":3,"detail":"exit(i)","documentation":{"kind":"markdown","value":"Exit process with status i, which defaults to 0."},"sortText":"2exit"},{"label":"exp","kind":3,"detail":"exp(r)","documentation":{"kind":"markdown","value":"E raised to the power r."},"sortText":"2exp"},{"label":"fattrib","kind":3,"detail":"fattrib(str,att)","documentation":{"kind":"markdown","value":"Get the attribute of a file"},"sortText":"2fattrib"},{"label":"find","kind":3,"detail":"find(s1,s2,i1,i2)","documentation":{"kind":"markdown","value":"Generates the sequence of positions in s2 at which s1 occurs as a substring in s2[i1:i2], but fails if there is no such position."},"sortText":"2find"},{"label":"flush","kind":3,"detail":"flush(f)","documentation":{"kind":"markdown","value":"Flush file f."},"sortText":"2flush"},{"label":"function","kind":3,"detail":"function()","documentation":{"kind":"markdown","value":"Generate the names of the functions."},"sortText":"2function"},{"label":"get","kind":3,"detail":"get(L)","documentation":{"kind":"markdown","value":"Remove and produce an element from the left end of list L."},"sortText":"2get"},{"label":"getch","kind":3,"detail":"getch()","documentation":{"kind":"markdown","value":"Return a character from console."},"sortText":"2getch"},{"label":"getche","kind":3,"detail":"getche()","documentation":{"kind":"markdown","value":"Return a character from console with echo."},"sortText":"2getche"},{"label":"getenv","kind":3,"detail":"getenv(s)","documentation":{"kind":"markdown","value":"Return contents of environment variable s."},"sortText":"2getenv"},{"label":"iand","kind":3,"detail":"iand(i,j)","documentation":{"kind":"markdown","value":"Bitwise AND of i and j."},"sortText":"2iand"},{"label":"icom","kind":3,"detail":"icom(i)","documentation":{"kind":"markdown","value":"Produce bitwise complement (one's complement) of i."},"sortText":"2icom"},{"label":"image","kind":3,"detail":"image(x)","documentation":{"kind":"markdown","value":"Return string image of object x."},"sortText":"2image"},{"label":"insert","kind":3,"detail":"insert(x1,x2,x3)","documentation":{"kind":"markdown","value":"Insert element x2 into set or table x1 if not already there if x1 is a table, the assigned value for element x2 is x3. (always succeeds and returns x1)."},"sortText":"2insert"},{"label":"integer","kind":3,"detail":"integer(x)","documentation":{"kind":"markdown","value":"Convert x to an integer, failing if that is not possible."},"sortText":"2integer"},{"label":"ior","kind":3,"detail":"ior(i,j)","documentation":{"kind":"markdown","value":"Bitwise inclusive OR of i and j."},"sortText":"2ior"},{"label":"ishift","kind":3,"detail":"ishift(i,j)","documentation":{"kind":"markdown","value":"Produce i shifted j bit positions (left if j\u003c0, right if j\u003e0)."},"sortText":"