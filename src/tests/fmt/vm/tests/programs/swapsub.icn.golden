# :=: and <-> on two substrings of one string: the one to the right shifts
# by the change in length of the other, as iconx's swap and rswap adjust it.
procedure main()
   local s
   s := "abcdef"; s[1] :=: s[3:5]; write(s)
   s := "abcdef"; s[3:5] :=: s[1]; write(s)
   s := "abcdefgh"; s[2:4] :=: s[6:9]; write(s)
   s := "abcdefgh"; s[6:9] :=: s[2:4]; write(s)
   s := "abcdefgh"; (s[1] <-> s[4:7]) & write(s) & &fail; write(s)
   s := "abcdefgh"; (s[4:7] <-> s[1]) & write(s) & &fail; write(s)
   s := "abcdef"; write(s[1:3] :=: s[5]); write(s)
   s := "abcdef"; s[2:5] :=: s[3]; write(s)
end
status 0
