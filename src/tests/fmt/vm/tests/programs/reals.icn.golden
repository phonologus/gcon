# Reals: literals, formatting, arithmetic, conversion and functions.
procedure main()
   local x
   every writes(1.5 | 2.0 | 1e20 | 1e-5 | 0.1 | 1.0 / 3 | 100.0 | 1e10 | 12345678901.0 | -0.0 | 0.5e1, " ")
   write()
   every writes(123456.789 | 2.0 ^ 0.5 | 1e100 | 3.0e-10 | 1e15 | 1e16 | 123456789012.0 | 9999999999.0, " ")
   write()
   every writes(0.000123 | 0.0001 | 1234567890.0 | 12345678904.0 | 1.0e-4 | 2.5e-7 | 6.02214076e23, " ")
   write()
   every writes(1 / 3.0 | 2 / 3.0 | 10 / 3.0 | 1e9 / 7 | -1e-9 / 7 | 1.1 * 1.1 | 0.1 + 0.2 | 1e308, " ")
   write()
   write(1 + 2.5, " ", 7 / 2.0, " ", 7.5 % 2, " ", -7.5 % 2, " ", 2 ^ 0.5, " ", 2.0 ^ 3, " ", 4 ^ -1.0)
   write((-2.0) ^ 2, " ", (-2.0) ^ 3, " ", 2.0 ^ -2, " ", 1.5 ^ 10, " ", 10.0 ^ 15, " ", 3 ^ 0.0)
   write(image(1.5), " ", type(1.5), " ", image("1.5" + 0), " ", " 2.5e2 " * 1, " ", "1." + 0, " ", ".5" + 0)
   write("+.5" + 0, " ", "1E3" + 0, " ", "16r10" + 0.5, " ", image(numeric("1e")) | "not numeric")
   write(integer(3.7), " ", integer(-3.7), " ", integer("3.7"), " ", real(3), " ", real("2"), " ", numeric("1e2"), " ", numeric("12"))
   write(image(real("x")) | "noreal", " ", image(numeric("1e400")) | "overflow is not numeric")
   write(1 < 1.5, " ", 2.0 = 2, " ", image(2 = 2.0), " ", -(2.5), " ", +3.0, " ", image(3.0 === 3) | "3.0 ~=== 3")
   write(image(2.5 === 2.5), " ", 1.5 < 2, " ", image(1.5 > 2) | "no")
   write(&pi, " ", &e, " ", &phi)
   write(sqrt(2), " ", exp(1), " ", log(100, 10), " ", log(8, 2), " ", log(1), " ", sin(0), " ", cos(0))
   write(atan(1, 1), " ", atan(1), " ", dtor(180), " ", rtod(&pi), " ", asin(1), " ", acos(1), " ", tan(0.5))
   write(abs(-3), " ", abs(-3.5), " ", abs(4), " ", 10 * 1.1, " ", exp(1000), " ", -exp(1000))
   every writes(1.9 to 3.9, " ")
   write()
   write(2.5 || "x", " ", *3.25, " ", *1e20)
   x := 1.0
   every 1 to 10 do x *:= 1.5
   write(x)
   x := 0.0
   every 1 to 10 do x +:= 0.1
   write(x, " ", x = 1.0 | "not exactly 1")
end
status 0
