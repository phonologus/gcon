== stdin
# Integer arithmetic and numeric conversion.
procedure main()
   write(7 + 3, " ", 7 - 3, " ", 7 * 3, " ", 7 / 3, " ", 7 % 3, " ", 7 ^ 3)
   write(-7 / 3, " ", -7 % 3, " ", 7 / -3, " ", 7 % -3)
   write(2 ^ 0, " ", 2 ^ -1, " ", 1 ^ -5, " ", (-1) ^ -3, " ", (-1) ^ -4, " ", (-2) ^ 3)
   write(-(3), " ", +"4", " ", - -5)
   write("10" + 5, " ", " 7 " * 2, " ", "16rff" + 0, " ", "2r1010" - 0, " ", "-3" + 0)
   write(16rFF, " ", 36rZZ, " ", 8r777, " ", 2r1111)
   write(3 < 5, " ", 5 > 3, " ", 3 <= 3, " ", 3 >= 3, " ", 3 = 3, " ", 3 ~= 4)
   write(image(3 > 5) | "3 > 5 fails")
   write(1 < 2 < 3, " ", image(1 < 3 < 2) | "chain fails")
   write(9223372036854775807, " ", -9223372036854775807 - 1)
   write(type(1), " ", image(42), " ", image(-42))
   x := 10
   x +:= 5; write(x)
   x -:= 3; write(x)
   x *:= 2; write(x)
   x /:= 5; write(x)
   x %:= 3; write(x)
   x ^:= 4; write(x)
   write(x < 100)
end
