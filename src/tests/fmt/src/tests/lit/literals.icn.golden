# gcon's literals, good and bad: the language server reports what
# gcon build reports (src/tests/lsp.sh).
procedure main()
   write("caf\u00e9", "\U01F600", "\x41\101\^A")
   write('a..z', '\u0100..\u017f', 'a..a', '\x00..\x7f')
   write("\u{zz}")
   write("\u12")
   write("\U110000")
   write("\U1f6", "\U01f6000")
   write('z..a')
   write('a..')
   write('..z')
   write('a...b')
   write('\xff..\u0100')
   write("fine", 'a..cx..z')
   write(u'α..ω', u'\x80..\xff', u'a..é', u'')
   write(u'é..\xff')
   write(u'ω..α')
   write(u'a...b')
end
status 0
