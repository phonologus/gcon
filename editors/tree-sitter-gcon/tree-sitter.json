{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gcon",
      "camelcase": "Gcon",
      "title": "Icon (gcon)",
      "scope": "source.icon",
      "path": ".",
      "file-types": [
        "icn"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(icon|gcon)$"
    }
  ],
  "metadata": {
    "version": "0.4.2",
    "license": "MIT",
    "description": "Icon grammar for tree-sitter, as Gcon reads Icon",
    "links": {
      "repository": "https://github.com/phonologus/gcon"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
